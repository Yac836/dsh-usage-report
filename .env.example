# Optional host data root. Replace YOUR_USER with the account running DSH.
# Keep the actual DSH home outside this source checkout.
# DSH_HOME=C:/Users/YOUR_USER/.dsh

# This plugin does not load .env files or accept provider credentials.
# Set DSH_HOME in the process environment when launching the DSH host.
# Plugin display options belong in the profile patch; see examples/.
# Configure provider authentication in the host through its supported external
# secret mechanism. Never add API keys, tokens, cookies or recovery codes here.
